# Names only. Copy to .env locally; never commit real values.
# Production/staging values live in each host's secret store and GitHub Actions secrets.

# --- API: runtime ---
NODE_ENV=
PORT=
LOG_LEVEL=
WEB_ORIGIN=
API_ORIGIN=

# --- API: database (Neon) ---
# Pooled TCP connection string (runtime)
DATABASE_URL=
# Direct (non-pooled) connection string (migrations)
DATABASE_URL_DIRECT=

# --- API: sessions ---
SESSION_COOKIE_NAME=
# None until a real domain exists (plan 2.3), then Lax
SESSION_COOKIE_SAMESITE=
SESSION_TTL_HOURS=

# --- API: file storage (Backblaze B2, S3-compatible) ---
B2_ENDPOINT=
B2_REGION=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
B2_BACKUP_BUCKET=
PRESIGN_TTL_SECONDS=
MAX_UPLOAD_BYTES=

# --- API: email ---
# console | brevo | resend
EMAIL_PROVIDER=
EMAIL_FROM=
BREVO_API_KEY=
RESEND_API_KEY=

# --- API: retry tick ---
TICK_SHARED_SECRET=
TICK_MAX_ATTEMPTS=

# --- Web (Vite) ---
VITE_API_BASE_URL=

# --- Cron worker (Cloudflare) ---
API_TICK_URL=
# Same value as the API's TICK_SHARED_SECRET, stored as a Worker secret
TICK_SECRET=

# --- CI/CD (GitHub Actions secrets) ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=
RENDER_DEPLOY_HOOK_URL=
