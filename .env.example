# Names only. Copy to .env locally (repo root, gitignored); never commit real values.
# Production values live in Render's and Cloudflare's own variable panels.
# Variables marked "(Phase N)" aren't read by the code yet.

# --- API (Render web service "docflow") ---
NODE_ENV=
# Leave unset on Render (it injects 10000); local default 3000
PORT=
LOG_LEVEL=
# Exact web origin for CORS, e.g. https://docflow.<subdomain>.workers.dev
WEB_ORIGIN=

# Neon pooled connection string (host contains -pooler), runtime queries
DATABASE_URL=
# Neon direct connection string, migrations (run at container start)
DATABASE_URL_DIRECT=

# none until a real domain exists (plan.md §2.3), then lax
SESSION_COOKIE_SAMESITE=
# Session lifetime in hours (default 12)
SESSION_TTL_HOURS=

# Shared with the cron worker's TICK_SECRET, at least 32 characters
TICK_SHARED_SECRET=

# File storage, Backblaze B2 S3-compatible API (Phase 3)
B2_ENDPOINT=
B2_REGION=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
B2_BACKUP_BUCKET=
PRESIGN_TTL_SECONDS=
MAX_UPLOAD_BYTES=

# Email (Phase 5). brevo | resend | console
EMAIL_PROVIDER=brevo
EMAIL_FROM=
BREVO_API_KEY=
RESEND_API_KEY=
TICK_MAX_ATTEMPTS=

# --- Web (Cloudflare Worker "docflow") — BUILD variables, not runtime ---
VITE_API_BASE_URL=
# Cloudflare's build image defaults to pnpm 10; must match package.json packageManager
PNPM_VERSION=

# --- Cron worker (Cloudflare Worker "docflow-cron") ---
# API_TICK_URL is a plain var in infra/cron-worker/wrangler.jsonc.
# Runtime secret, same value as TICK_SHARED_SECRET (locally: infra/cron-worker/.dev.vars)
TICK_SECRET=
